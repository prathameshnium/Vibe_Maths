import OMAReductions.R_DubnerConjecture_dubner_conjecture_R1
import Mathlib

-- Step DubnerConjecture.dubner_conjecture.R1.H1: hypothesis H1 of reduction DubnerConjecture.dubner_conjecture.R1
-- Credit: @prathameshnium. Kernel-checked finite verification: for every even n with 4208 < n ≤ 10000 a
-- witness p (packed 12 bits each into one natural number) is checked by a verified trial-division
-- primality test so that p and n - p are both twin primes; the whole check runs in `decide +kernel`.

/-! Step DubnerConjecture.dubner_conjecture.R1.H1. -/

namespace DubnerStepH1

/-- `noDiv p f d = true` means no `m` with `d ≤ m` and `m * m ≤ p` divides `p` (fuel `f`). -/
def noDiv (p : Nat) : Nat → Nat → Bool
  | 0, _ => false
  | f + 1, d => Nat.blt p (d * d) || (!(Nat.beq (p % d) 0) && noDiv p f (d + 1))

theorem noDiv_sound (p : Nat) : ∀ f d, noDiv p f d = true →
    ∀ m, d ≤ m → m * m ≤ p → ¬ m ∣ p := by
  intro f
  induction f with
  | zero => intro d h; simp [noDiv] at h
  | succ f ih =>
    intro d h m hdm hmm hdvd
    simp only [noDiv, Bool.or_eq_true, Bool.and_eq_true, Bool.not_eq_true',
      Nat.blt_eq] at h
    rcases h with h | ⟨h1, h2⟩
    · have : d * d ≤ m * m := Nat.mul_le_mul hdm hdm
      omega
    · rcases Nat.eq_or_lt_of_le hdm with h | h
      · subst h
        have : p % d = 0 := Nat.mod_eq_zero_of_dvd hdvd
        simp [this] at h1
      · exact ih (d + 1) h2 m h hmm hdvd

/-- Trial-division primality test. -/
def isPrimeB (p : Nat) : Bool := Nat.ble 2 p && noDiv p p 2

theorem isPrimeB_sound (p : Nat) (h : isPrimeB p = true) : p.Prime := by
  simp only [isPrimeB, Bool.and_eq_true, Nat.ble_eq] at h
  obtain ⟨h2, hnd⟩ := h
  by_contra hnp
  have hne : p ≠ 1 := by omega
  have hmp := Nat.minFac_prime hne
  have hsq := Nat.minFac_sq_le_self (by omega) hnp
  exact noDiv_sound p p 2 hnd p.minFac hmp.two_le (by simpa [sq] using hsq) (Nat.minFac_dvd p)

def isTwinB (p : Nat) : Bool := isPrimeB p && (isPrimeB (p - 2) || isPrimeB (p + 2))

theorem isTwinB_sound (p : Nat) (h : isTwinB p = true) : DubnerConjecture.IsTwinPrime p := by
  simp only [isTwinB, Bool.and_eq_true, Bool.or_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  refine ⟨isPrimeB_sound p h1, ?_⟩
  rcases h2 with h2 | h2
  · exact Or.inl (isPrimeB_sound _ h2)
  · exact Or.inr (isPrimeB_sound _ h2)

def okPair (n p : Nat) : Bool := Nat.ble p n && isTwinB p && isTwinB (n - p)

/-- Check the `c` even numbers `n, n + 2, ...`, the witnesses packed `K` bits each in `W`. -/
def go (K : Nat) : Nat → Nat → Nat → Bool
  | 0, _, _ => true
  | c + 1, n, W => okPair n (W % 2 ^ K) && go K c (n + 2) (W / 2 ^ K)

theorem go_sound (K : Nat) : ∀ c n W, go K c n W = true → ∀ i, i < c →
    ∃ p q : ℕ, DubnerConjecture.IsTwinPrime p ∧ DubnerConjecture.IsTwinPrime q ∧
      p + q = n + 2 * i := by
  intro c
  induction c with
  | zero => intro n W _ i hi; omega
  | succ c ih =>
    intro n W h i hi
    simp only [go, okPair, Bool.and_eq_true, Nat.ble_eq] at h
    obtain ⟨⟨⟨hle, hp⟩, hq⟩, hrest⟩ := h
    rcases i with _ | i
    · exact ⟨_, _, isTwinB_sound _ hp, isTwinB_sound _ hq, by omega⟩
    · obtain ⟨p, q, hp', hq', hpq⟩ := ih (n + 2) _ hrest i (by omega)
      exact ⟨p, q, hp', hq', by omega⟩

/-- Packed witnesses: the `i`-th `K`-bit field is `p` for `n = 4210 + 2 * i`. -/
def W : Nat := 

theorem check : go 12 2896 4210 W = true := by decide +kernel

theorem solution' : OMA.R_DubnerConjecture_dubner_conjecture_R1.H1 := by
  intro n h1 h2 h3
  obtain ⟨k, hk⟩ := h3
  obtain ⟨p, q, hp, hq, hpq⟩ := go_sound 12 2896 4210 W check ((n - 4210) / 2) (by omega)
  exact ⟨p, q, hp, hq, by omega⟩

end DubnerStepH1

theorem OMA.solution : OMA.R_DubnerConjecture_dubner_conjecture_R1.H1 :=
  DubnerStepH1.solution'
